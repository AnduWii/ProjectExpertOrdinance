{
  "name": "chrome2",
  "productName": "Chrome2",
  "version": "0.1.0",
  "description": "A minimal Chromium-based desktop web browser built on Electron.",
  "main": "src/main/main.js",
  "author": "AnduWii",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --test-reporter=spec \"test/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never -c.mac.identity=-",
    "dist:linux": "electron-builder --linux --publish never",
    "dist": "npm run dist:win && npm run dist:mac",
    "dist:mac:signed": "electron-builder --mac --publish never -c.mac.hardenedRuntime=true"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  },
  "dependencies": {
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0"
  }
}
